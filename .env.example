# Copia este fichero a `.env` y rellena LLM_API_KEY.
#
# ESTE fichero SI se versiona: no pegues aqui ninguna clave real.
# El que esta en .gitignore es `.env`.

# --- Obligatoria ---
# https://platform.openai.com/api-keys
LLM_API_KEY=

# --- Modelo (opcionales; estos son los valores por defecto) ---

# Endpoint OpenAI-compatible. Cualquier otro proveedor funciona, pero solo
# OpenAI cubre las tres cosas a la vez (tool calling fiable, embeddings para la
# memoria y busqueda web). Ver "Proveedores alternativos" en el README.
#   OpenAI      -> https://api.openai.com/v1
#   Groq        -> https://api.groq.com/openai/v1
#   OpenRouter  -> https://openrouter.ai/api/v1
#   Cerebras    -> https://api.cerebras.ai/v1
LLM_BASE_URL=https://api.openai.com/v1

# ID del modelo. Para el agente hace falta uno solido en tool calling nativo.
#   gpt-5.5                 -> el mejor de los probados
#   gpt-5.4                 -> funciona igual de bien
#   gpt-5.6-*, *-pro        -> NO sirven: no admiten tools en chat completions
LLM_MODEL=gpt-5.5

# Los modelos gpt-5.x, o1, o3 y o4 solo admiten su temperatura por defecto:
# con ellos esta variable se ignora (el codigo lo detecta y no la envia).
LLM_TEMPERATURE=0.7

# Ojo: los planes gratuitos cuentan max_tokens como tokens "solicitados" para
# el limite por minuto y por dia, se usen o no. Subirlo reduce las preguntas
# que caben al dia; bajarlo de 1024 rompe los modelos que razonan antes de
# responder.
LLM_MAX_TOKENS=2048

# Rate limiter de cliente. Mantenlo por debajo de la cuota del proveedor.
LLM_REQUESTS_PER_MINUTE=25

# Mensaje de sistema para el modo chat (sin base de datos configurada).
SYSTEM_PROMPT=

# debug | info | warn | error
# debug muestra el consumo de tokens, los resultados de las tools y las trazas.
LOG_LEVEL=info

# --- Base de datos (opcional) ---
# Sin DATABASE_URL la aplicacion arranca como chat normal, sin herramientas.
# El acceso es SIEMPRE de solo lectura, con independencia del usuario que pongas.
DATABASE_URL=

# Esquemas visibles para el agente, separados por comas.
DB_SCHEMAS=public

# Tope de filas por consulta. Se aplica aunque el modelo olvide el LIMIT.
DB_MAX_ROWS=100

# statement_timeout de Postgres, en milisegundos.
DB_TIMEOUT_MS=15000

# --- MongoDB (opcional, solo lectura) ---
# La base va DENTRO de la URL a proposito: el agente queda acotado a esa y no
# puede saltar a otra del mismo servidor.
MONGODB_URL=

# Tope de documentos por consulta.
MONGO_MAX_DOCS=50

# Documentos que se muestrean para inferir el esquema (MongoDB no tiene uno).
MONGO_SAMPLE_SIZE=100

# maxTimeMS de las operaciones, en milisegundos.
MONGO_TIMEOUT_MS=15000

# --- Memoria permanente ---
# Fichero SQLite donde se guarda lo que pidas recordar. Esta en .gitignore.
MEMORY_DB_PATH=.memory.db

# Modelo de embeddings para la busqueda por significado.
# Vacio = solo busqueda por palabras (FTS5). Groq no ofrece embeddings, asi que
# con Groq se desactiva sola y avisa la primera vez.
EMBEDDINGS_MODEL=text-embedding-3-small

# Endpoint de embeddings. Por defecto el mismo que LLM_BASE_URL. Ponlo si
# quieres chatear con Groq (gratis) pero vectorizar con OpenAI (centimos).
EMBEDDINGS_BASE_URL=

# Memorias relevantes que se inyectan automaticamente en cada pregunta.
# 0 lo desactiva: entonces solo se aplican las fijas y lo que el agente busque.
MEMORY_AUTO_RECALL=4

# --- Busqueda en internet ---
# Modelo con busqueda web integrada. No hace falta dar de alta ningun servicio
# aparte: usa la misma API key del chat. Vacio = sin tool de busqueda.
#   gpt-4o-mini-search-preview -> barato, 2 citas por busqueda (recomendado)
#   gpt-4o-search-preview      -> algo mas profundo, 3 citas
#   gpt-5-search-api           -> 7 citas, pero mete los resultados en el
#                                 prompt: ~31.000 tokens por busqueda
WEB_SEARCH_MODEL=gpt-4o-mini-search-preview

# Endpoint de busqueda. Por defecto el mismo que LLM_BASE_URL. Groq no tiene
# modelos con busqueda web: con Groq la tool se desactiva sola y avisa.
WEB_SEARCH_BASE_URL=

# --- Agente ---
# Iteraciones maximas por pregunta antes de rendirse.
AGENT_MAX_STEPS=8

# --- Interfaz web (opcional) ---
# Puerto de la API que consume el frontend (bun run serve).
PORT=3001
