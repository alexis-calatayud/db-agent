{
  "name": "agents",
  "version": "0.1.0",
  "description": "Agente de IA de consola sobre smolagents (Fase 1: uso del modelo)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
